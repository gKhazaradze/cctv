{
  "name": "citywatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browse public live CCTV / webcam feeds from city centres around the world.",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:cams": "node scripts/check-cameras.mjs",
    "check:cams:json": "node scripts/check-cameras.mjs --json"
  },
  "dependencies": {
    "hls.js": "^1.5.17",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
