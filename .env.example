# Copy to .env (Docker) or .env.local (local npm) and fill in.

# ---------------------------------------------------------------- Docker ----
# Read by docker-compose.yml.

# Host port for the app. Default 8080.
CITYWATCH_PORT=8080

# Host port for the dev-profile server. Default 5173.
CITYWATCH_DEV_PORT=5173

# Optional. Free key from https://api.windy.com/keys (choose the "Webcams" product).
# Read at container start-up, so changing it needs a restart, not a rebuild.
# Without it, cameras with source.kind === 'windy' show a "needs a key"
# placeholder. Windy's free tier serves still images, not live video.
WINDY_API_KEY=

# ------------------------------------------------------------ local (npm) ---
# Vite only exposes variables prefixed with VITE_, and bakes them in at build
# time. Put this one in .env.local when running outside Docker.
VITE_WINDY_API_KEY=
